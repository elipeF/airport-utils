{
  "name": "airport-utils",
  "version": "1.0.0",
  "description": "Convert local ISO 8601 timestamps to UTC using airport IATA codes, with airport geo-data",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.cjs",
      "import": "./dist/esm/index.js"
    },
    "./converter": {
      "types": "./dist/types/converter.d.ts",
      "require": "./dist/cjs/converter.cjs",
      "import": "./dist/esm/converter.js"
    },
    "./info": {
      "types": "./dist/types/info.d.ts",
      "require": "./dist/cjs/info.cjs",
      "import": "./dist/esm/info.js"
    },
    "./errors": {
      "types": "./dist/types/errors.d.ts",
      "require": "./dist/cjs/errors.cjs",
      "import": "./dist/esm/errors.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#mapping/geo": "./src/mapping/geo.ts",
    "#mapping/timezones": "./src/mapping/timezones.ts"
  },
  "type": "module",
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.json"
  ],
  "sideEffects": false,
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/elipeF/airport-utils.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist/types",
    "build:js": "rolldown -c && node scripts/dedupeBuildMappings.mjs",
    "build": "npm run build:types && npm run build:js",
    "typecheck": "tsc --build --noEmit",
    "lint": "oxlint src tests scripts vitest.config.ts rolldown.config.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "npm run typecheck && npm run build && vitest run --coverage",
    "update:mapping": "node --input-type=module --eval \"import { generateMapping } from './scripts/generateMapping.ts'; await generateMapping();\""
  },
  "keywords": [
    "amadeus",
    "timezone",
    "iata",
    "iso8601",
    "utc",
    "airport",
    "geo"
  ],
  "license": "MIT",
  "dependencies": {
    "@date-fns/tz": "^1.5.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "rolldown": "^1.2.0",
    "semantic-release": "^25.0.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "npm": "^11.18.0"
  }
}
